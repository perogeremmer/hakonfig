{
  "productName": "Hakonfig",
  "version": "0.5.1",
  "identifier": "dev.perogeremmer.hakonfig",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "bun run css && bun run logos"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hakonfig",
        "width": 1200,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Kelola konfigurasi provider AI coding harness",
    "longDescription": "Hakonfig membaca, mengubah, dan menulis konfigurasi provider/model pada harness AI coding (Pi, Oh My Pi, OpenCode, Hermes) tanpa mengedit file secara manual.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "publisher": "perogeremmer",
    "homepage": "https://github.com/perogeremmer/hakonfig",
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/hakonfig/copyright": "../LICENSE"
        }
      }
    }
  },
  "mainBinaryName": "hakonfig"
}
