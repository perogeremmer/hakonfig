{
  "productName": "Rekonfig",
  "version": "0.1.0",
  "identifier": "dev.hudya.rekonfig",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rekonfig",
        "width": 1200,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Kelola konfigurasi provider AI coding harness",
    "longDescription": "Rekonfig membaca, mengubah, dan menulis konfigurasi provider/model pada harness AI coding (Pi, oh-my-pi, OpenCode, Hermes) tanpa mengedit file secara manual.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
