{
  "name": "hakonfig",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i ./web/styles.src.css -o ./web/styles.css --minify",
    "css:watch": "tailwindcss -i ./web/styles.src.css -o ./web/styles.css --watch",
    "logos": "node scripts/sync-logos.mjs",
    "dev": "bun run css && tauri dev",
    "build": "bun run css && tauri build",
    "test": "bun run test:rust && bun run test:js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "test:js": "node --test web/diff.test.js web/i18n.test.js web/form.test.js web/provider-form.test.js web/logo-index.test.js web/offline.test.js",
    "version": "node scripts/version.mjs show",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@tauri-apps/cli": "^2",
    "tailwindcss": "^4"
  },
  "license": "MIT",
  "homepage": "https://github.com/perogeremmer/hakonfig",
  "repository": {
    "type": "git",
    "url": "https://github.com/perogeremmer/hakonfig.git"
  }
}
